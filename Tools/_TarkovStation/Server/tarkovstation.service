[Unit]
Description=TarkovStation server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=tarkovstation
Group=tarkovstation
WorkingDirectory=/opt/tarkovstation
Environment=TARKOV_DATA_DIR=/var/lib/tarkovstation
Environment=TARKOV_CONFIG_FILE=/etc/tarkovstation/server.toml
EnvironmentFile=-/etc/tarkovstation/server.env
ExecStart=/usr/bin/bash /opt/tarkovstation/run-server.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/tarkovstation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
